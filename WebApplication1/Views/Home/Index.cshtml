@{
    ViewData["Title"] = "Dashboard";
    var devices = ViewBag.Devices as System.Data.DataTable;
}

<!-- Welcome Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold">Welcome back 👋</h3>
        <p class="text-muted m-0">Control and manage your smart devices with Smart Universal IR Hub.</p>
    </div>
    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Hub Online
    </span>
</div>

<!-- 4 Thẻ Thống Kê (Stat Cards) -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-light rounded-3 text-primary fs-4"><i class="bi bi-phone"></i></div>
                <div>
                    <small class="text-muted fw-medium">Total Devices</small>
                    <h3 class="fw-bold m-0">@(devices != null ? devices.Rows.Count : 0)</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-success-subtle text-success rounded-3 fs-4"><i class="bi bi-circle-fill"></i></div>
                <div>
                    <small class="text-muted fw-medium">Online Devices</small>
                    <h3 class="fw-bold m-0">@(devices != null ? devices.Rows.Count : 0)</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-primary-subtle text-primary rounded-3 fs-4"><i class="bi bi-bounding-box-circles"></i></div>
                <div>
                    <small class="text-muted fw-medium">Scenes</small>
                    <h3 class="fw-bold m-0">1</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-warning-subtle text-warning rounded-3 fs-4"><i class="bi bi-clock"></i></div>
                <div>
                    <small class="text-muted fw-medium">Schedules</small>
                    <h3 class="fw-bold m-0">2</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Nội dung: ESP32 Connected Modules & Quick Actions -->
<div class="row g-4">
    <!-- Cột Trái: ESP32 Connected Modules (Đã ẩn bảng My Devices cũ) -->
    <div class="col-md-7 d-flex flex-column gap-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold m-0">ESP32 Connected Modules</h5>
                    <small class="text-muted">Active hardware modules via MQTT</small>
                </div>
                <span id="dashboardBrokerPill" class="badge bg-secondary">broker: chưa kết nối</span>
            </div>

            <ul class="list-unstyled m-0" id="dashboardEspDevices"></ul>
            <p class="text-muted m-0 text-center py-2" id="dashboardEmptyEsp">Chưa có module ESP32 nào kết nối.</p>
        </div>
    </div>

    <!-- Cột Phải: Quick Actions -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <h5 class="fw-bold m-0">Quick Actions</h5>
            <small class="text-muted mb-3 d-block">Frequently used controls</small>

            <div class="d-flex flex-column gap-3">
                <a href="/Home/Provision" class="text-decoration-none">
                    <div class="p-3 border rounded-4 d-flex align-items-center gap-3 bg-light-subtle hover-shadow">
                        <div class="p-2 bg-white rounded-3 border text-primary fs-4"><i class="bi bi-bluetooth"></i></div>
                        <div>
                            <h6 class="fw-bold m-0 text-dark">Add New Module</h6>
                            <small class="text-muted">Register a new IR appliance or module</small>
                        </div>
                    </div>
                </a>

                <div class="p-3 border rounded-4 d-flex align-items-center gap-3 bg-light-subtle" onclick="location.href='/Home/Scenes'" style="cursor: pointer;">
                    <div class="p-2 bg-white rounded-3 border text-warning fs-4"><i class="bi bi-lightning-charge"></i></div>
                    <div>
                        <h6 class="fw-bold m-0 text-dark">Run Scene</h6>
                        <small class="text-muted">Execute 'Sleep Mode' macro</small>
                    </div>
                </div>

                <div class="p-3 border rounded-4 d-flex align-items-center gap-3 bg-light-subtle" onclick="location.href='/Home/Schedule'" style="cursor: pointer;">
                    <div class="p-2 bg-white rounded-3 border text-info fs-4"><i class="bi bi-clock"></i></div>
                    <div>
                        <h6 class="fw-bold m-0 text-dark">Schedule</h6>
                        <small class="text-muted">Create an automatic action</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL BẬT REMOTE ĐIỀU KHIỂN -->
<div class="modal fade" id="remoteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-5 border-0 shadow-lg" style="background: #0f172a; color: white;">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold" id="remoteModalTitle">Remote Control</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-danger rounded-pill px-3 py-2" id="irLed"><i class="bi bi-broadcast"></i> IR READY</span>
                    <button class="btn btn-sm btn-outline-warning" onclick="openLearnModal()">+ Learn New Button</button>
                </div>
                <hr class="border-secondary mb-4" />
                <div id="remoteButtonsArea" class="row g-3 justify-content-center"></div>
            </div>
        </div>
    </div>
</div>

<!-- Toast Thông Báo -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050">
    <div id="statusToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage">Thông báo</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<!-- Thư viện MQTT qua CDN để nhận trạng thái phần cứng -->
<script src="https://cdn.jsdelivr.net/npm/mqtt@5/dist/mqtt.min.js"></script>

@section Scripts {
    <script>
        let currentSelectedDeviceId = 0;

        // Quản lý trạng thái ESP32 qua MQTT trên Dashboard
        const topicStatus = (id) => `devices/${id}/status`;
        const topicCmd    = (id) => `devices/${id}/cmd`;

        function loadLocal(k, def) { try { return JSON.parse(localStorage.getItem(k)) ?? def; } catch { return def; } }

        let brokerConfig = loadLocal('broker', { host: 'broker.hivemq.com', wsPort: 8884 });
        const espStates = {};
        let mqttClient = null;

        function initDashboardMqtt() {
            // Tự động tạo 1 module ảo mẫu để test nếu chưa có thiết bị nào
            let espDevices = loadLocal('devices', []);
            if (espDevices.length === 0) {
                espDevices.push({ hwId: "ESP32_VIRTUAL_9999" });
                localStorage.setItem('devices', JSON.stringify(espDevices));
            }

            if (!brokerConfig.host || espDevices.length === 0) {
                renderEspList();
                return;
            }

            // ĐÃ CẬP NHẬT URL SANG CHUẨN WSS VÀ /mqtt CỦA HIVEMQ CLOUD
            const url = `wss://${brokerConfig.host}:${brokerConfig.wsPort}/mqtt`;
            mqttClient = mqtt.connect(url, { reconnectPeriod: 3000, connectTimeout: 5000 });

            mqttClient.on('connect', () => {
                setDashboardBrokerPill(true);
                espDevices.forEach((d) => mqttClient.subscribe(topicStatus(d.hwId)));
            });
            mqttClient.on('close', () => setDashboardBrokerPill(false));
            mqttClient.on('error', () => setDashboardBrokerPill(false));
            mqttClient.on('message', (topic, payload) => {
                const m = topic.match(/^devices\/([^/]+)\/status$/);
                if (!m) return;
                try {
                    espStates[m[1]] = JSON.parse(payload.toString());
                } catch {
                    espStates[m[1]] = { online: false };
                }
                renderEspList();
            });
            renderEspList();
        }

        function setDashboardBrokerPill(on) {
            const pill = document.getElementById('dashboardBrokerPill');
            if (!pill) return;
            pill.textContent = 'broker: ' + (on ? 'đã kết nối' : 'chưa kết nối');
            pill.className = 'badge ' + (on ? 'bg-success' : 'bg-secondary');
        }

        // Hiển thị danh sách module ESP32 kèm nút chuyển hướng sang Devices và Remote độc lập
        function renderEspList() {
            const ul = document.getElementById('dashboardEspDevices');
            const empty = document.getElementById('dashboardEmptyEsp');
            if (!ul || !empty) return;

            let espDevices = loadLocal('devices', []);
            ul.innerHTML = '';
            empty.classList.toggle('d-none', espDevices.length > 0);

            espDevices.forEach((d) => {
                const s = espStates[d.hwId];
                const online = s ? !!s.online : true; // Mặc định hiển thị online cho module ảo để dễ test

                const li = document.createElement('li');
                li.className = 'd-flex justify-content-between align-items-center py-3 border-bottom flex-wrap gap-2';

                const left = document.createElement('div');
                left.innerHTML = `
                    <div class="fw-bold text-dark">
                        <i class="bi bi-cpu text-primary me-1"></i> Module: ${d.hwId} 
                        <span class="badge ${online ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary'} rounded-pill ms-2">
                            ${online ? 'online' : 'offline'}
                        </span>
                    </div>
                    <div class="text-muted small font-monospace">Trang thiết bị & remote độc lập cho module này</div>
                `;

                const right = document.createElement('div');
                right.className = 'd-flex gap-2';

                // Nút mở trang Devices riêng cho từng module
                const bDevices = document.createElement('button');
                bDevices.className = 'btn btn-sm btn-outline-primary';
                bDevices.innerHTML = '<i class="bi bi-display"></i> Devices';
                bDevices.onclick = () => { location.href = `/Home/Devices?hwId=${d.hwId}`; };

                // Nút mở trang Remote riêng cho từng module
                const bRemote = document.createElement('button');
                bRemote.className = 'btn btn-sm btn-primary';
                bRemote.innerHTML = '<i class="bi bi-badge-vr"></i> Remote';
                bRemote.onclick = () => { location.href = `/Home/Remote?hwId=${d.hwId}`; };

                right.append(bDevices, bRemote);
                li.append(left, right);
                ul.appendChild(li);
            });
        }

        // Khởi chạy MQTT khi vừa tải xong trang Dashboard
        document.addEventListener("DOMContentLoaded", function () {
            initDashboardMqtt();
        });

        // Các hàm xử lý Remote modal cũ
        function openRemoteModal(deviceId) {
            currentSelectedDeviceId = deviceId;
            let area = document.getElementById('remoteButtonsArea');
            area.innerHTML = '<div class="spinner-border text-info my-4" role="status"></div>';

            let modal = new bootstrap.Modal(document.getElementById('remoteModal'));
            modal.show();

            fetch('/Home/GetButtons?deviceId=' + deviceId)
                .then(res => res.json())
                .then(data => {
                    area.innerHTML = '';
                    if (data.length === 0) {
                        area.innerHTML = '<p class="text-warning my-4">Thiết bị này chưa có nút bấm nào.</p>';
                        return;
                    }

                    data.forEach(btn => {
                        let col = document.createElement('div');
                        col.className = 'col-6';
                        let btnColor = btn.buttonName.toLowerCase().includes('nguồn') ? 'btn-danger fw-bold' : 'btn-outline-light';

                        col.innerHTML = `
                            <button class="btn ${btnColor} w-100 py-3 rounded-4 shadow-sm"
                                    onclick="sendIRCommand(${btn.buttonId}, '${btn.protocol}', '${btn.hexCode}', ${btn.bits})">
                                <i class="bi bi-power me-1"></i> ${btn.buttonName}
                            </button>
                        `;
                        area.appendChild(col);
                    });
                });
        }

        function sendIRCommand(buttonId, protocol, hexCode, bits) {
            let led = document.getElementById('irLed');
            led.className = 'badge bg-warning text-dark rounded-pill px-3 py-2';
            led.innerHTML = '<i class="bi bi-broadcast"></i> SENDING...';

            fetch('/Home/SendIRCommand', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ButtonId: buttonId, Protocol: protocol, HexCode: hexCode, Bits: bits })
            })
            .then(res => res.json())
            .then(data => {
                setTimeout(() => {
                    led.className = 'badge bg-danger rounded-pill px-3 py-2';
                    led.innerHTML = '<i class="bi bi-broadcast"></i> IR READY';
                }, 500);
                showToast(data.message, data.success);
            });
        }

        function showToast(msg, isSuccess) {
            let toastElem = document.getElementById('statusToast');
            toastElem.className = isSuccess
                ? 'toast align-items-center text-white bg-success border-0'
                : 'toast align-items-center text-white bg-danger border-0';
            document.getElementById('toastMessage').innerText = msg;
            let toast = new bootstrap.Toast(toastElem);
            toast.show();
        }
    </script>
}