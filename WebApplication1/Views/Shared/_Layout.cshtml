<!DOCTYPE html><html lang="vi"><head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart IR Hub</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #f4f6f9;
                color: #333;
            }

            /* Sidebar Styling */
            .sidebar {
                width: 260px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background-color: #111827;
                color: #9ca3af;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                z-index: 1000;
            }

            .sidebar-brand {
                padding: 20px;
                color: #ffffff;
                font-weight: 700;
                font-size: 1.25rem;
                display: flex;
                align-items: center;
                gap: 12px;
            }

                .sidebar-brand .logo-icon {
                    background: #2563eb;
                    color: white;
                    padding: 6px 12px;
                    border-radius: 8px;
                    font-size: 0.9rem;
                }

            .sidebar-menu {
                list-style: none;
                padding: 0 12px;
                margin-top: 10px;
            }

            .menu-header {
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: #6b7280;
                padding: 10px 16px 5px;
                font-weight: 600;
            }

            .sidebar-menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                color: #9ca3af;
                text-decoration: none;
                border-radius: 10px;
                font-weight: 500;
                transition: all 0.2s;
                margin-bottom: 4px;
            }

                .sidebar-menu a:hover, .sidebar-menu a.active {
                    background-color: #2563eb;
                    color: #ffffff;
                }

            /* Main Content Styling */
            .main-wrapper {
                margin-left: 260px;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .top-navbar {
                height: 70px;
                background: #ffffff;
                border-bottom: 1px solid #e5e7eb;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
            }

            .content-body {
                padding: 30px;
                flex-grow: 1;
            }

            .hub-status-badge {
                background: #1f2937;
                border-radius: 12px;
                padding: 12px;
                margin: 15px;
                display: flex;
                align-items: center;
                gap: 10px;
                color: white;
                font-size: 0.85rem;
            }
    </style></head><body>

    <!-- SIDEBAR BÊN TRÁI -->
    <div class="sidebar">
        <div>
            <div class="sidebar-brand">
                <span class="logo-icon">IR</span>
                <div>
                    <div>Smart IR</div>
                    <small style="font-size: 0.7rem; color: #6b7280; font-weight: 400;">Universal Hub</small>
                </div>
            </div>

            <div class="menu-header">Main Menu</div>
            <ul class="sidebar-menu">
                <li>
                    <a href="/Home/Index" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a href="/Home/Provision" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Provision" ? "active" : "")">
                        <i class="bi bi-bluetooth"></i> Add New Module
                    </a>
                </li>
                <!-- Ẩn Devices và Remote khỏi sidebar menu chính để truy cập độc lập qua từng module -->
                <!--
                <li>
                    <a href="/Home/Devices" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Devices" ? "active" : "")">
                        <i class="bi bi-display"></i> Devices
                    </a>
                </li>
                <li>
                    <a href="/Home/Remote" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Remote" ? "active" : "")">
                        <i class="bi bi-badge-vr"></i> Remote
                    </a>
                </li>
                -->
                <li>
                    <a href="/Home/Learning" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Learning" ? "active" : "")">
                        <i class="bi bi-broadcast"></i> Learning
                    </a>
                </li>
                <li>
                    <a href="/Home/Scenes" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Scenes" ? "active" : "")">
                        <i class="bi bi-bounding-box-circles"></i> Scenes
                    </a>
                </li>
                <li>
                    <a href="/Home/Schedule" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Schedule" ? "active" : "")">
                        <i class="bi bi-clock-history"></i> Schedule
                    </a>
                </li>
                <li>
                    <a href="/Home/Settings" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
                        <i class="bi bi-gear"></i> Settings
                    </a>
                </li>
            </ul>
        </div>

        <!-- Trạng thái Hub dưới góc trái -->
        <div class="hub-status-badge">
            <span class="spinner-grow spinner-grow-sm text-success" role="status"></span>
            <div>
                <div class="fw-bold">Hub Online</div>
                <small class="text-secondary" style="font-size: 0.75rem;">Connected</small>
            </div>
        </div>
    </div>

    <!-- NỘI DUNG CHÍNH BÊN PHẢI -->
    <div class="main-wrapper">
        <!-- Top Navbar Header -->
        <div class="top-navbar">
            <div>
                <h5 class="fw-bold m-0">@ViewData["Title"]</h5>
                <small class="text-muted">Smart Universal IR Hub</small>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-light rounded-circle p-2 position-relative">
                    <i class="bi bi-bell"></i>
                </button>
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-weight: 600;">U</div>
                    <div>
                        <div class="fw-bold style-sm" style="font-size: 0.85rem;">User</div>
                        <small class="text-muted" style="font-size: 0.75rem;">Administrator</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Body Render -->
        <div class="content-body">
            @RenderBody()
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)</body></html>